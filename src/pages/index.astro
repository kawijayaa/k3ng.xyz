---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
---
<BaseLayout>
  <main id="main-content">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-name"><h1 id="intro-title">k3ng<span class="name-period">.</span></h1><a class="profile-stamp" href="/about"><img src="/profile.png" width="156" height="156" alt="k3ng’s profile" /><span>About me ↗</span></a></div>
      <div class="hero-bottom">
        <div class="hero-intro"><p>Forensics enjoyer.<br />Occasional challenge author.</p></div><div class="hero-actions"><a class="primary-link" href="/writeups">Writeups <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="hero-links" aria-label="Social profiles"><a href="https://github.com/kawijayaa" target="_blank" rel="noreferrer">GitHub ↗</a><a href="https://linkedin.com/in/muhammadoka" target="_blank" rel="noreferrer">LinkedIn ↗</a><a href="https://discord.com/users/243690464795033601" target="_blank" rel="noreferrer">Discord ↗</a><a href="https://ctftime.org/user/147526" target="_blank" rel="noreferrer">CTFtime ↗</a></div>
    </section>
    <section class="home-section" aria-labelledby="latest-title"><div class="section-heading"><div><h2 id="latest-title">Latest posts<span>.</span></h2></div><a href="/blog">All posts <span aria-hidden="true">↗</span></a></div><div class="blog-grid">{posts.map((post) => <BlogCard post={post} />)}</div></section>
  </main>
</BaseLayout>
